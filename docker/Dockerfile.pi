# Plain Docker isolation for Pi.
# Built per docs/containerization.md "Run Pi in plain Docker".
FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# --- Sandbox plugins: SAIA provider + token-efficiency modes -------------------
# Pre-installed so a freshly-built pi-sandbox ships with all four working.
# - pi-saia-plugin: auto-registers the SAIA Academic Cloud provider + models;
#   models appear when SAIA_API_KEY is passed at runtime.
# - opencode-ponytail: minimal-code rules (/ponytail lite|full|ultra|off).
# - pi-caveman: terse-prose output, ~75% fewer output tokens (/caveman ...).
# - @sherif-fanous/pi-rtk: routes shell commands through the rtk binary when
#   present; degrades to unchanged commands otherwise (/rtk status).
# NOTE: pi-saia-plugin needs git (already installed above). The npm deprecation
# warning for opencode-ponytail is harmless.
RUN pi install git:github.com/tobias-weiss-ai-xr/pi-saia-plugin \
 && pi install npm:opencode-ponytail \
 && pi install npm:pi-caveman \
 && pi install npm:@sherif-fanous/pi-rtk

# --- Non-root `pi` user with a baked, writable agent home ---------------------
# The default entrypoint runs as root (keeps the eval probes / historical
# results stable), but a hardened production launch is `--user pi` with
# [network dropped + read-only root + tmpfs + caps dropped] — see
# harness/run-hardened.sh / `make sandbox`. `pi` is a dedicated UID 1000
# user whose .pi/agent already ships the four plugins. UID 1001 (1000 = `node`).
RUN useradd --create-home --uid 1001 --shell /bin/bash pi \
 && mkdir -p /home/pi/.pi/agent \
 && cp -a /root/.pi/agent/. /home/pi/.pi/agent/ \
 && chown -R pi:pi /home/pi/.pi/agent \
 && cp -a /home/pi/.pi/agent /opt/pi-agent-that-template \
 && mv /opt/pi-agent-that-template /opt/pi-agent \
 && chown -R pi:pi /opt/pi-agent

WORKDIR /workspace
ENTRYPOINT ["pi"]
